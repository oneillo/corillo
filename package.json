{
  "name": "corillo",
  "productName": "Corillo",
  "version": "0.1.0",
  "description": "A Mac app for writing Markdown documents together with your AI agents, the way you'd work with colleagues.",
  "license": "MIT",
  "private": true,
  "main": "dist/main.cjs",
  "scripts": {
    "prebuild": "node scripts/sweep-temp.mjs",
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "licences": "node scripts/check-licences.mjs",
    "fetch-pandoc": "node scripts/fetch-pandoc.mjs",
    "pretest:unit": "node scripts/sweep-temp.mjs",
    "test:unit": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test": "npm run typecheck && npm run build && vitest run && node scripts/check-licences.mjs && playwright test",
    "typecheck": "tsc -p .",
    "package": "npm run build && node scripts/package-mac.mjs",
    "test:package": "npm run package && playwright test -c playwright.package.config.ts",
    "bench": "npm run build && playwright test -c playwright.bench.config.ts",
    "help-pictures": "npm run build && playwright test -c playwright.pictures.config.ts help-pictures",
    "screens": "npm run build && playwright test -c playwright.pictures.config.ts screens"
  },
  "dependencies": {
    "markdown-it": "^14.3.3",
    "markdown-it-footnote": "^4.0.0",
    "mermaid": "^12.3.0",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-dropcursor": "^1.8.4",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.9",
    "prosemirror-model": "^1.25.13",
    "prosemirror-schema-list": "^1.6.0",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.12.5",
    "prosemirror-view": "^1.42.9",
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/markdown-it": "^14.2.0",
    "@types/markdown-it-footnote": "^3.0.4",
    "@types/node": "^26.6.6",
    "electron": "^45.2.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "type": "module"
}
